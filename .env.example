# Public Supabase configuration (safe to expose to the browser).
# Project Settings → API → Project URL / publishable key.
# (Older projects call the public key the "anon" key; either env name works.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used for trusted admin operations and certificate issuance.
# Never prefix this with NEXT_PUBLIC_ and never import it into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
